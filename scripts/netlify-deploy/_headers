# No cachear HTML, SW, JS ni versión: iPhone, Android y Huawei deben ver el deploy al abrir.
# La PWA arranca en / (no en /index.html): si / se cachea, iOS no actualiza.
/
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache

/*.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache

/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache

/admin-panel.html
  Cache-Control: no-cache, no-store, must-revalidate

/manifest.json
  Cache-Control: no-cache, no-store, must-revalidate

/deploy-version.json
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache

/js/*
  Cache-Control: no-cache, no-store, must-revalidate
