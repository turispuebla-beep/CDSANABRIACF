# =============================================================================

# Plantilla — Netlify → Site configuration → Environment variables

# Proyecto: CDSANABRIACF (cdsanabriacf.netlify.app)

# Guía correo: docs/EMAIL-SOCIOS.md

# =============================================================================



# --- URL pública (sin barra final) ---

SITE_URL=https://www.cdsanabriacf.com

ALLOWED_ORIGINS=https://www.cdsanabriacf.com,https://cdsanabriacf.com,https://cdsanabriacf.netlify.app



# --- Gmail SMTP — buzón único del club ---

# Cuenta: cdsanabriafc@gmail.com

CLUB_PUBLIC_EMAIL=cdsanabriafc@gmail.com

# 1) Verificación en 2 pasos en esa cuenta Google

# 2) https://myaccount.google.com/apppasswords → contraseña de aplicación "Correo"

# 3) SMTP_PASS = 16 caracteres sin espacios

SMTP_HOST=smtp.gmail.com

SMTP_PORT=587

SMTP_USER=cdsanabriafc@gmail.com

SMTP_PASS=xxxx-xxxx-xxxx-xxxx

SMTP_FROM_EMAIL=cdsanabriafc@gmail.com

SMTP_FROM_NAME=CD Sanabria CF

CLUB_REPLY_EMAIL=cdsanabriafc@gmail.com

CLUB_NOTIFY_EMAIL=cdsanabriafc@gmail.com

# Avisos internos (solicitud nuevo jugador, transferencias pendientes, etc.): solo al buzón del club (true por defecto).
# Excepciones (van DIRECTO al usuario con copia BCC al club):
#   - Confirmación registro socio (member_registered)
#   - Cuota socio pagada (pasarela o validación manual)
#   - Inscripción jugador/a pagada (pasarela)
#   - Solicitud aceptada al jugador/a
#   - Restablecer contraseña de ficha
#   - Inscripción / pago de eventos al inscrito
CLUB_EMAIL_ONLY=true



# --- OPCIÓN B (opcional): SendGrid — solo si no usas Gmail SMTP ---

# SENDGRID_API_KEY=SG.xxx...

# SENDGRID_FROM_EMAIL=cdsanabriafc@gmail.com

# SENDGRID_FROM_NAME=CD Sanabria CF

# CLUB_REPLY_EMAIL=cdsanabriafc@gmail.com

# CLUB_NOTIFY_EMAIL=cdsanabriafc@gmail.com



# --- Firebase Admin (JSON en UNA sola línea) ---
# Firebase Console → cdsanabriacf2026 → Configuración → Cuentas de servicio → Generar clave
# Pegar el JSON completo en UNA línea (sin saltos). Obligatorio para:
#   approve-player-application, submit-member-registration, submit-friend-registration,
#   submit-player-application, submit-player-inscription, submit-club-record, Redsys.

FIREBASE_SERVICE_ACCOUNT_JSON=



# --- Redsys / Caja Rural (pago cuota, inscripción jugador, eventos — TPV tarjeta/Bizum) ---

# Clave SHA-256 del terminal (Ruralvía). Pegar tal cual; no usar SHA-512.
REDSYS_SECRET_KEY=

REDSYS_MERCHANT_CODE=

REDSYS_TERMINAL=101

REDSYS_ENV=test

REDSYS_BIZUM_ENABLED=false

# PayGold SMS (panel admin). Desactivar sin quitar TPV: REDSYS_PAYGOLD_DISABLED=true



# --- Temporada de socios (cierre cuota anual y plazos de pago) ---

# Cierre de temporada: día y mes (mayo = 5). Tras esta fecha los activos pasan a pendiente de renovación.

MEMBERSHIP_SEASON_CLOSE_MONTH=5

MEMBERSHIP_SEASON_CLOSE_DAY=31

# Plazo para transferencia, efectivo y TPV manual (altas nuevas pendientes)

MEMBERSHIP_PAYMENT_DEADLINE_DAYS=7

# Primer año de cierre de referencia (edad menor/mayor al 31/05 de ese año)

MEMBERSHIP_SEASON_FIRST_CLOSE_YEAR=2027

# Cuota inscripción equipo torneo (€) — pago tarjeta al finalizar plantilla. 0 = sin cobro online.

TORNEO_INSCRIPTION_FEE_EUR=0

# Secreto opcional para invocar cron/manual member-season-renewal (Bearer). El cron de Netlify usa cabecera interna.

NETLIFY_CRON_SECRET=

# Solo avisos internos al club (true por defecto). Ya configurado arriba si aplica.

CLUB_EMAIL_ONLY=true

# --- Redsys (pagos tarjeta/Bizum) — añadir cuando el club tenga claves TPV ---

# REDSYS_MERCHANT_CODE=
# REDSYS_TERMINAL=101
# REDSYS_SECRET_KEY=
# REDSYS_ENV=test
# REDSYS_BIZUM_ENABLED=false

